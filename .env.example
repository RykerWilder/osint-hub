# Copy this file to ".env" to change the settings (it is optional).

# Name shown in the interface and in the reports
APP_NAME=osint-hub

# Port and address to open the interface on (http://localhost:8080)
WEB_PORT=8080
# 127.0.0.1 = this computer only. 0.0.0.0 = the local network too (never expose it to the Internet: there is no login)
BIND_ADDRESS=127.0.0.1

# How many tools can run at the same time
MAX_CONCURRENT_JOBS=4
# Maximum time for a single tool, in seconds
TOOL_TIMEOUT=900
# How many searches to keep in the history (the oldest are deleted)
MAX_SCANS=100
# Country used to read phone numbers that have no international prefix (e.g. IT, US, GB)
DEFAULT_PHONE_REGION=IT

# Maximum size of a file uploaded in the "File" section, in MB (maximum 500)
MAX_UPLOAD_MB=100

# Optional: free key from numverify.com for PhoneInfoga (carrier and line type)
NUMVERIFY_API_KEY=
